{
  "description": "User-invoked agent skills (slash commands) for development workflows. Works with Claude Code, OpenAI Codex, and Cursor.",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "markdownlint-cli": "0.49.1"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "license": "MIT",
  "lint-staged": {
    "*.json": [
      "bunx biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx markdownlint-cli --fix"
    ],
    "*.sh": [
      "shellcheck"
    ]
  },
  "name": "ship-shit-dev-library",
  "overrides": {
    "brace-expansion": "^5.0.11",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.2",
    "smol-toml": "^1.9.0",
    "linkify-it": "^5.0.2",
    "picomatch": "4.0.4"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "deps:update": "bunx npm-check-updates -u && bun install",
    "lint": "bun run lint:md && bun run lint:code && bun run lint:sh",
    "lint:code": "bunx biome check .",
    "lint:md": "bunx markdownlint-cli \"**/*.md\"",
    "lint:md:fix": "bunx markdownlint-cli \"**/*.md\" --fix",
    "lint:sh": "find skills -name \"*.sh\" -exec shellcheck {} +",
    "prepare": "husky",
    "test": "bun run test:py && bun run test:js",
    "test:js": "find skills -name \"*.test.mjs\" -not -path \"*/node_modules/*\" -exec node --test {} +",
    "test:py": "python3 -m unittest discover -s scripts/tests -p \"test_*.py\" && for d in skills/*/tests; do python3 -m unittest discover -s \"$d\" -p \"test_*.py\" || exit 1; done",
    "validate": "python3 scripts/validate.py && bun scripts/validate-codex.mjs"
  },
  "version": "2.2.4"
}
